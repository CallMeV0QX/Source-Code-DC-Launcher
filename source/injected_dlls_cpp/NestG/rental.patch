+struct Manifest { uint64_t gid = 0; uint64_t size = 0; };
+struct Data {
+    std::map<uint32_t, std::string> depotKeys;
+    std::map<uint32_t, uint64_t> accessTokens;
+    std::map<uint32_t, uint64_t> statIds;
+    std::map<uint32_t, Manifest> manifests;
+    std::vector<uint32_t> pinned;
+};
+
+inline bool Decimal(std::string_view text, uint64_t& value) {
+    if (text.empty() || text.size() > 20 ||
+        text.find_first_not_of("0123456789") != std::string_view::npos) return false;
+    const auto parsed = std::from_chars(text.data(), text.data() + text.size(), value);
+    return parsed.ec == std::errc{} && parsed.ptr == text.data() + text.size();
+}
+
+class DataParser {
+    std::string_view input;
+    size_t pos = 0;
+    bool invalid = false;
+    void Space() {
+        for (;;) {
+            while (pos < input.size() && std::isspace(static_cast<unsigned char>(input[pos]))) ++pos;
+            if (input.substr(pos, 2) != "--") return;
+            pos += 2;
+            if (input.substr(pos, 2) == "[[") {
+                const auto end = input.find("]]", pos + 2);
+                if (end == std::string_view::npos) { invalid = true; return; }
+                pos = end + 2;
+            } else {
+                const auto end = input.find('\n', pos);
+                pos = end == std::string_view::npos ? input.size() : end + 1;
+            }
+        }
+    }
+    bool Take(char ch) { Space(); if (invalid || pos >= input.size() || input[pos] != ch) return false; ++pos; return true; }
+    bool Literal(std::string& value) {
+        Space(); value.clear(); if (invalid || pos >= input.size()) return false;
+        const char first = input[pos];
+        if (first == '\'' || first == '"') {
+            ++pos;
+            while (pos < input.size()) {
+                const char ch = input[pos++];
+                if (ch == first) return true;
+                if (ch == '\\' || ch == '\r' || ch == '\n' || static_cast<unsigned char>(ch) < 32) return false;
+                value.push_back(ch);
+                if (value.size() > 128) return false;
+            }
+            return false;
+        }
+        while (pos < input.size() && input[pos] >= '0' && input[pos] <= '9') value.push_back(input[pos++]);
+        return !value.empty() && value.size() <= 20;
+    }
+public:
+    explicit DataParser(std::string_view value) : input(value) {}
+    bool Parse(Data& output) {
+        if (input.size() > 1024 * 1024 || input.find('\0') != std::string_view::npos) return false;
+        Data candidate;
+        size_t calls = 0;
+        for (;;) {
+            Space(); if (invalid) return false;
+            if (pos == input.size()) { output = std::move(candidate); return calls > 0; }
+            const auto begin = pos;
+            while (pos < input.size() && std::isalpha(static_cast<unsigned char>(input[pos]))) ++pos;
+            if (begin == pos || pos - begin > 24 || ++calls > 8192) return false;
+            std::string name(input.substr(begin, pos - begin));
+            std::transform(name.begin(), name.end(), name.begin(), [](unsigned char ch) { return static_cast<char>(std::tolower(ch)); });
+            if (!Take('(')) return false;
+            std::vector<std::string> args(1);
+            if (!Literal(args[0])) return false;
+            while (Take(',')) { if (args.size() >= 3) return false; args.emplace_back(); if (!Literal(args.back())) return false; }
+            if (!Take(')')) return false;
+            Take(';');
+            uint64_t first = 0, second = 0;
+            if (!Decimal(args[0], first) || first == 0 || first > UINT32_MAX) return false;
+            const auto id = static_cast<uint32_t>(first);
+            if (name == "addappid") {
+                if (args.size() > 1 && !Decimal(args[1], second)) return false;
+                std::string key;
+                if (args.size() == 3) {
+                    key = args[2];
+                    if (key.size() != 64 || key.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos) return false;
+                }
+                auto [it, added] = candidate.depotKeys.emplace(id, key);
+                if (!added && !key.empty()) {
+                    if (!it->second.empty() && it->second != key) return false;
+                    it->second = key;
+                }
+            } else if (name == "addtoken" || name == "setstat" || name == "setmanifestid") {
+                if (args.size() < 2 || args.size() > (name == "setmanifestid" ? 3u : 2u) ||
+                    !Decimal(args[1], second) || second == 0) return false;
+                if (name == "addtoken") candidate.accessTokens[id] = second;
+                else if (name == "setstat") candidate.statIds[id] = second;
+                else {
+                    uint64_t ignored = 0;
+                    if (args.size() == 3 && !Decimal(args[2], ignored)) return false;
+                    candidate.manifests[id] = { second, 0 };
+                }
+            } else if (name == "pinapp" && args.size() == 1) candidate.pinned.push_back(id);
+            else return false; // No arbitrary Lua, HTTP, credential writes or globals.
+        }
+    }
+};
+
+inline bool Merge(Data& target, const Data& source) {
+    for (const auto& [id, key] : source.depotKeys) {
+        auto it = target.depotKeys.find(id);
+        if (it != target.depotKeys.end() && !key.empty() && !it->second.empty() && it->second != key) return false;
+    }
+    for (const auto& [id, manifest] : source.manifests) {
+        auto it = target.manifests.find(id);
+        if (it != target.manifests.end() && it->second.gid != manifest.gid) return false;
+    }
+    for (const auto& [id, key] : source.depotKeys) if (!key.empty() || !target.depotKeys.count(id)) target.depotKeys[id] = key;
+    target.accessTokens.insert(source.accessTokens.begin(), source.accessTokens.end());
+    target.statIds.insert(source.statIds.begin(), source.statIds.end());
+    target.manifests.insert(source.manifests.begin(), source.manifests.end());
+    target.pinned.insert(target.pinned.end(), source.pinned.begin(), source.pinned.end());
+    return true;
+}
+}
diff --git a/src/NestG/RentalIdentity.cpp b/src/NestG/RentalIdentity.cpp
new file mode 100644
index 0000000..702bbe1
--- /dev/null
+++ b/src/NestG/RentalIdentity.cpp
@@ -0,0 +1,109 @@
+#include "RentalIdentity.h"
+
+namespace RentalIdentity {
+namespace {
+// As with the existing pinned-runtime watchers, keep synchronization alive
+// through Windows process teardown. No worker or destructor runs in DllMain.
+Tracker& RuntimeTracker() {
+    static auto* tracker = new Tracker;
+    return *tracker;
+}
+}
+
+bool Tracker::IsIndividualSteamId(std::uint64_t steamId) {
+    // Public universe, individual account, desktop instance, nonzero AccountID.
+    return (steamId >> 56) == 1 && ((steamId >> 52) & 0xf) == 1 &&
+           ((steamId >> 32) & 0xfffff) == 1 && (steamId & 0xffffffffu) != 0;
+}
+
+Snapshot Tracker::Capture() const {
+    std::lock_guard lock(mutex_);
+    return snapshot_;
+}
+
+void Tracker::InvalidateLocked(State state) {
+    if (snapshot_.state == State::Authenticated) {
+        if (retiredSessions_.size() >= 32768) ambiguousAttempt_ = true;
+        else retiredSessions_.emplace(snapshot_.steamId, snapshot_.steamSessionId);
+    }
+    ++snapshot_.generation;
+    snapshot_.state = state;
+    snapshot_.steamId = 0;
+    snapshot_.steamSessionId = 0;
+    expectedSteamId_ = 0;
+}
+
+void Tracker::SetObserverAvailability(bool sendInstalled, bool receiveInstalled) {
+    std::lock_guard lock(mutex_);
+    const bool ready = sendInstalled && receiveInstalled;
+    if (snapshot_.observerReady == ready) return;
+    if (!ready && snapshot_.state == State::Pending) ambiguousAttempt_ = true;
+    snapshot_.observerReady = ready;
+    InvalidateLocked(State::Unknown);
+}
+
+void Tracker::BeginLogon(std::uint64_t expectedSteamId) {
+    std::lock_guard lock(mutex_);
+    // The existing hook has no proven per-attempt request correlation. An
+    // overlapping request could receive an old same-account reply; do not
+    // guess a socket layout or treat that reply as a new proof. A fresh Steam
+    // process is required after ambiguity (ordinary terminal Guard failures
+    // leave Unknown and permit a later non-overlapping attempt).
+    if (snapshot_.state == State::Pending) ambiguousAttempt_ = true;
+    InvalidateLocked(snapshot_.observerReady && !ambiguousAttempt_ ? State::Pending : State::Unknown);
+    // Only a correlation hint; never permission to load rental data.
+    if (IsIndividualSteamId(expectedSteamId)) expectedSteamId_ = expectedSteamId;
+}
+
+void Tracker::SignOut() {
+    std::lock_guard lock(mutex_);
+    if (snapshot_.state == State::Pending) ambiguousAttempt_ = true;
+    InvalidateLocked(State::SignedOut);
+}
+
+void Tracker::ObserveLogonResponse(std::int32_t result, bool hasResult,
+                                  std::uint64_t steamId, std::int32_t sessionId) {
+    std::lock_guard lock(mutex_);
+    // Late replies after logout, unsolicited replies and duplicate replies do
+    // not reauthorize an account. Every proof belongs to an observed login.
+    if (!snapshot_.observerReady || ambiguousAttempt_ || snapshot_.state != State::Pending) return;
+    if (!hasResult || result != 1 || !IsIndividualSteamId(steamId) ||
+        sessionId == 0 || retiredSessions_.count({steamId, sessionId}) ||
+        (expectedSteamId_ != 0 && expectedSteamId_ != steamId)) {
+        InvalidateLocked(State::Unknown);
+        return;
+    }
+    ++snapshot_.generation;
+    snapshot_.state = State::Authenticated;
+    snapshot_.steamId = steamId;
+    snapshot_.steamSessionId = sessionId;
+    expectedSteamId_ = 0;
+}
+
+void Tracker::ObserveAuthenticatedHeader(std::uint64_t steamId, std::int32_t sessionId,
+                                        bool hasSteamId, bool hasSessionId) {
+    std::lock_guard lock(mutex_);
+    if (snapshot_.state != State::Authenticated) return;
+    // Generic traffic can invalidate an old proof, but cannot grant a new one.
+    // Some service headers omit identity/session, so absence is not a mismatch.
+    if ((hasSteamId && steamId != 0 && steamId != snapshot_.steamId) ||
+        (hasSessionId && sessionId != 0 && sessionId != snapshot_.steamSessionId)) {
+        InvalidateLocked(State::Unknown);
+    }
+}
+
+Snapshot Capture() { return RuntimeTracker().Capture(); }
+void SetObserverAvailability(bool send, bool receive) {
+    RuntimeTracker().SetObserverAvailability(send, receive);
+}
+void BeginLogon(std::uint64_t steamId) { RuntimeTracker().BeginLogon(steamId); }
+void SignOut() { RuntimeTracker().SignOut(); }
+void ObserveLogonResponse(std::int32_t result, bool hasResult,
+                          std::uint64_t steamId, std::int32_t sessionId) {
+    RuntimeTracker().ObserveLogonResponse(result, hasResult, steamId, sessionId);
+}
+void ObserveAuthenticatedHeader(std::uint64_t steamId, std::int32_t sessionId,
+                                bool hasSteamId, bool hasSessionId) {
+    RuntimeTracker().ObserveAuthenticatedHeader(steamId, sessionId, hasSteamId, hasSessionId);
+}
+} // namespace RentalIdentity
diff --git a/src/NestG/RentalIdentity.h b/src/NestG/RentalIdentity.h
new file mode 100644
index 0000000..55e5eb4
--- /dev/null
+++ b/src/NestG/RentalIdentity.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include <cstdint>
+#include <mutex>
+#include <set>
+#include <utility>
+
+// Identity is observed from the original Steam connection before Better modifies
+// any IPC response. A selected account, VDF entry, registry value, game ticket or
+// outbound logon request is never sufficient to authorize a rental source.
+namespace RentalIdentity {
+
+enum class State { Unknown, Pending, Authenticated, SignedOut };
+
+struct Snapshot {
+    State state = State::Unknown;
+    std::uint64_t steamId = 0;
+    std::uint64_t generation = 0;
+    std::int32_t steamSessionId = 0;
+    bool observerReady = false;
+};
+
+class Tracker {
+public:
+    Snapshot Capture() const;
+    void SetObserverAvailability(bool sendInstalled, bool receiveInstalled);
+    void BeginLogon(std::uint64_t expectedSteamId = 0);
+    void SignOut();
+    void ObserveLogonResponse(std::int32_t result, bool hasResult,
+                              std::uint64_t steamId, std::int32_t sessionId);
+    void ObserveAuthenticatedHeader(std::uint64_t steamId, std::int32_t sessionId,
+                                    bool hasSteamId, bool hasSessionId);
+    static bool IsIndividualSteamId(std::uint64_t steamId);
+
+private:
+    void InvalidateLocked(State state);
+    mutable std::mutex mutex_;
+    Snapshot snapshot_;
+    std::uint64_t expectedSteamId_ = 0;
+    bool ambiguousAttempt_ = false;
+    std::set<std::pair<std::uint64_t, std::int32_t>> retiredSessions_;
+};
+
+Snapshot Capture();
+void SetObserverAvailability(bool sendInstalled, bool receiveInstalled);
+void BeginLogon(std::uint64_t expectedSteamId = 0);
+void SignOut();
+void ObserveLogonResponse(std::int32_t result, bool hasResult,
+                          std::uint64_t steamId, std::int32_t sessionId);
+void ObserveAuthenticatedHeader(std::uint64_t steamId, std::int32_t sessionId,
+                                bool hasSteamId, bool hasSessionId);
+
+} // namespace RentalIdentity
diff --git a/src/NestG/RentalJson.h b/src/NestG/RentalJson.h
new file mode 100644
index 0000000..361aafc
--- /dev/null
+++ b/src/NestG/RentalJson.h
@@ -0,0 +1,109 @@
+#pragma once
+#include "RentalData.h"
+#include <map>
+#include <stdexcept>
+
+namespace NestGRental {
+// Small bounded parser for the fixed runtime protocol. Duplicate object fields,
+// floating point numbers and strings with control characters are rejected.
+struct Json {
+    enum class Type { Null, Object, Array, String, Number, Boolean } type = Type::Null;
+    std::string text;
+    std::map<std::string, Json> object;
+    std::vector<Json> array;
+    const Json& At(const std::string& name) const {
+        if (type != Type::Object) throw std::runtime_error("json_type");
+        return object.at(name);
+    }
+    std::string String() const {
+        if (type != Type::String) throw std::runtime_error("json_type"); return text;
+    }
+    uint64_t Number() const {
+        uint64_t value = 0;
+        if (type != Type::Number || !Decimal(text, value)) throw std::runtime_error("json_number");
+        return value;
+    }
+};
+class JsonParser {
+    std::string_view text;
+    size_t pos = 0;
+    size_t nodes = 0;
+    void Space() { while (pos < text.size() && (text[pos] == ' ' || text[pos] == '\r' || text[pos] == '\n' || text[pos] == '\t')) ++pos; }
+    bool Take(char ch) { Space(); if (pos < text.size() && text[pos] == ch) { ++pos; return true; } return false; }
+    [[noreturn]] static void Fail() { throw std::runtime_error("json_invalid"); }
+    std::string String() {
+        if (!Take('"')) Fail();
+        std::string value;
+        while (pos < text.size()) {
+            char ch = text[pos++];
+            if (ch == '"') return value;
+            if (ch == '\\') {
+                if (pos >= text.size()) Fail(); ch = text[pos++];
+                switch (ch) {
+                case '"': case '\\': case '/': break;
+                case 'u': {
+                    if (text.size() - pos < 4 || text.substr(pos, 2) != "00") Fail();
+                    unsigned code = 0;
+                    for (size_t i = 0; i < 4; ++i) {
+                        const char digit = text[pos++]; code <<= 4;
+                        if (digit >= '0' && digit <= '9') code += digit - '0';
+                        else if (digit >= 'a' && digit <= 'f') code += digit - 'a' + 10;
+                        else if (digit >= 'A' && digit <= 'F') code += digit - 'A' + 10;
+                        else Fail();
+                    }
+                    if (code < 32 || code > 127) Fail(); ch = static_cast<char>(code); break;
+                }
+                default: Fail();
+                }
+            }
+            if (static_cast<unsigned char>(ch) < 32 || value.size() >= 4096) Fail();
+            value.push_back(ch);
+        }
+        Fail();
+    }
+    Json Value(size_t depth) {
+        Space(); if (depth > 12 || ++nodes > 40000 || pos >= text.size()) Fail();
+        Json result;
+        if (Take('{')) {
+            result.type = Json::Type::Object;
+            if (Take('}')) return result;
+            do {
+                const auto key = String(); if (!Take(':')) Fail();
+                if (!result.object.emplace(key, Value(depth + 1)).second) Fail();
+                if (Take('}')) return result;
+            } while (Take(','));
+            Fail();
+        }
+        if (Take('[')) {
+            result.type = Json::Type::Array;
+            if (Take(']')) return result;
+            do {
+                result.array.push_back(Value(depth + 1)); if (Take(']')) return result;
+            } while (Take(','));
+            Fail();
+        }
+        if (text[pos] == '"') { result.type = Json::Type::String; result.text = String(); return result; }
+        const auto start = pos;
+        while (pos < text.size() && text[pos] >= '0' && text[pos] <= '9') ++pos;
+        if (pos > start) {
+            result.type = Json::Type::Number; result.text = std::string(text.substr(start, pos - start));
+            if (result.text.size() > 1 && result.text[0] == '0') Fail();
+            result.Number(); return result;
+        }
+        for (const auto literal : {std::string_view("true"), std::string_view("false"), std::string_view("null")}) {
+            if (text.substr(pos, literal.size()) == literal) {
+                pos += literal.size(); result.type = literal == "null" ? Json::Type::Null : Json::Type::Boolean;
+                result.text = std::string(literal); return result;
+            }
+        }
+        Fail();
+    }
+public:
+    explicit JsonParser(std::string_view input) : text(input) {}
+    Json Parse() {
+        if (text.size() > 4 * 1024 * 1024) Fail();
+        if (text.substr(0, 3) == "\xEF\xBB\xBF") pos = 3;
+        auto result = Value(0); Space(); if (pos != text.size()) Fail(); return result;
+    }
+};
+}
