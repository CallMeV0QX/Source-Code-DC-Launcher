+; Preserve the Windows x64 argument registers, floating-point arguments and stack.
+; Tail-jump to the actual System32 export without inventing undocumented ABIs.
+EXTERN NestGResolveDwm:PROC
+.code
+DWM_THUNK MACRO index
+PUBLIC NestGDwm&index
+NestGDwm&index PROC FRAME
+    sub rsp, 0A8h
+    .allocstack 0A8h
+    .endprolog
+    mov [rsp+20h], rcx
+    mov [rsp+28h], rdx
+    mov [rsp+30h], r8
+    mov [rsp+38h], r9
+    movdqu [rsp+40h], xmm0
+    movdqu [rsp+50h], xmm1
+    movdqu [rsp+60h], xmm2
+    movdqu [rsp+70h], xmm3
+    mov ecx, index
+    call NestGResolveDwm
+    mov rcx, [rsp+20h]
+    mov rdx, [rsp+28h]
+    mov r8, [rsp+30h]
+    mov r9, [rsp+38h]
+    movdqu xmm0, [rsp+40h]
+    movdqu xmm1, [rsp+50h]
+    movdqu xmm2, [rsp+60h]
+    movdqu xmm3, [rsp+70h]
+    add rsp, 0A8h
+    jmp rax
+NestGDwm&index ENDP
+ENDM
