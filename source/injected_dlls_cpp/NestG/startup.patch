diff --git a/src/NestG/ProxyBootstrap.h b/src/NestG/ProxyBootstrap.h
new file mode 100644
index 0000000..224c116
--- /dev/null
+++ b/src/NestG/ProxyBootstrap.h
@@ -0,0 +1,46 @@
+#pragma once
+#include "StartupDiagnostics.h"
+
+namespace NestGProxy {
+inline bool IsSteamHost() noexcept {
+    wchar_t path[32768];
+    const DWORD length = GetModuleFileNameW(nullptr, path, ARRAYSIZE(path));
+    if (!length || length >= ARRAYSIZE(path)) return false;
+    const wchar_t* name = wcsrchr(path, L'\\');
+    return name && _wcsicmp(name + 1, L"steam.exe") == 0;
+}
+
+inline DWORD WINAPI Initialize(void* module) noexcept {
+    NestGStartup::Write("proxy.worker");
+    wchar_t path[32768];
+    DWORD length = GetModuleFileNameW(static_cast<HMODULE>(module), path, ARRAYSIZE(path));
+    if (!length || length >= ARRAYSIZE(path) - 16) {
+        NestGStartup::Write("proxy.path.failed", GetLastError()); return 0;
+    }
+    wchar_t* slash = wcsrchr(path, L'\\');
+    if (!slash) { NestGStartup::Write("proxy.path.failed", ERROR_BAD_PATHNAME); return 0; }
+    wcscpy_s(slash + 1, ARRAYSIZE(path) - (slash + 1 - path), L"NestG.dll");
+    NestGStartup::Write("proxy.load.begin");
+    HMODULE runtime = LoadLibraryExW(path, nullptr,
+        LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (!runtime) { NestGStartup::Write("proxy.load.failed", GetLastError()); return 0; }
+    auto initialize = reinterpret_cast<void(WINAPI*)()>(GetProcAddress(runtime, "NestGInitialize"));
+    if (!initialize) { NestGStartup::Write("proxy.export.failed", GetLastError()); return 0; }
+    NestGStartup::Write("proxy.load.complete");
+    initialize(); // The runtime serializes initialization across both proxies.
+    return 0;
+}
+
+inline void Attach(HMODULE module) noexcept {
+    if (!IsSteamHost()) return;
+    // No LoadLibrary or waiting under the loader lock. Pin before scheduling so
+    // a host FreeLibrary cannot unmap the worker's instructions before it runs.
+    HMODULE pinned = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+            reinterpret_cast<LPCWSTR>(module), &pinned)) return;
+    HANDLE thread = CreateThread(nullptr, 0, Initialize, module, 0, nullptr);
+    if (thread) CloseHandle(thread);
+    else NestGStartup::Write("proxy.worker.failed", GetLastError());
+    // The optional runtime failing never makes the OS proxy's DllMain fail.
+}
+}
diff --git a/src/NestG/StartupDiagnostics.h b/src/NestG/StartupDiagnostics.h
new file mode 100644
index 0000000..48b2d73
--- /dev/null
+++ b/src/NestG/StartupDiagnostics.h
@@ -0,0 +1,53 @@
+#pragma once
+#include <windows.h>
+#include <cstdio>
+#include <cwchar>
+
+// Release diagnostics use fixed stage labels and numeric OS errors only.
+// Never enable upstream verbose logging of Lua, tickets or provider settings.
+namespace NestGStartup {
+inline void Write(const char* stage, DWORD error = ERROR_SUCCESS) noexcept {
+    const DWORD savedError = GetLastError();
+    HMODULE self = nullptr;
+    if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+            GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            reinterpret_cast<LPCWSTR>(&Write), &self)) {
+        wchar_t path[32768];
+        DWORD length = GetModuleFileNameW(self, path, ARRAYSIZE(path));
+        if (length && length < ARRAYSIZE(path) - 64) {
+            wchar_t* slash = wcsrchr(path, L'\\');
+            if (slash) {
+                wcscpy_s(slash + 1, ARRAYSIZE(path) - (slash + 1 - path), L"opensteamtool");
+                CreateDirectoryW(path, nullptr);
+                wcscat_s(path, L"\\nestg_startup.log");
+                HANDLE file = CreateFileW(path, GENERIC_WRITE, FILE_SHARE_READ, nullptr,
+                    OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+                if (file != INVALID_HANDLE_VALUE) {
+                    BY_HANDLE_FILE_INFORMATION info{};
+                    LARGE_INTEGER size{}, zero{};
+                    if (GetFileInformationByHandle(file, &info) &&
+                        !(info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) &&
+                        GetFileSizeEx(file, &size)) {
+                        if (size.QuadPart > 512 * 1024) {
+                            SetFilePointerEx(file, zero, nullptr, FILE_BEGIN);
+                            SetEndOfFile(file);
+                        }
+                        SetFilePointerEx(file, zero, nullptr, FILE_END);
+                        SYSTEMTIME time; GetSystemTime(&time);
+                        char line[256];
+                        int count = sprintf_s(line,
+                            "%04u-%02u-%02uT%02u:%02u:%02u.%03uZ PID=%lu TID=%lu Stage=%s Error=%lu\r\n",
+                            time.wYear, time.wMonth, time.wDay, time.wHour, time.wMinute,
+                            time.wSecond, time.wMilliseconds, GetCurrentProcessId(),
+                            GetCurrentThreadId(), stage, error);
+                        DWORD written;
+                        if (count > 0) WriteFile(file, line, count, &written, nullptr);
+                    }
+                    CloseHandle(file);
+                }
+            }
+        }
+    }
+    SetLastError(savedError);
+}
+}
